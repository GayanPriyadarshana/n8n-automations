    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    // 1. Navigate to the text string inside the nested structure\n    const rawText = item.json.output[0].content[0].text;\n\n    // 2. Since the text is a string that looks like JSON, we must parse it\n    const parsedData = JSON.parse(rawText);\n\n    // 3. Extract the specific fields and add them to our results array\n    results.push({\n      json: {\n        contact_id: parsedData.contact_id,\n        job_function: parsedData.job_function,\n        job_seniority: parsedData.job_seniority\n      }\n    });\n  } catch (error) {\n    // If an item is missing data, push an error field so the workflow doesn't crash\n    results.push({ json: { error: \"Could not parse text field\", details: error.message } });\n  }\n}\n\nreturn results;"
      },
